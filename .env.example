# Backend server config. Copy to .env and fill in real values. Never commit .env.
# (The API domain and HTTPS are configured in nginx - see scripts/setup-nginx.sh.)

# Frontend origins allowed to call the API (exact match, no trailing slash)
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com

LOG_LEVEL=info

# Database. Leave DB_HOST=db for the bundled MySQL container, or point it at a
# managed database (e.g. RDS Multi-AZ) to remove the single point of failure.
DB_HOST=db
DB_NAME=app
DB_USER=app
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Backups (db-backup service): every 24h, keep the newest 7
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=7

REGISTRY=local
TAG=latest
